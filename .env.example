# ============================================
# Imani Logistics - Environment Variables
# ============================================

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (change this to a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ============================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================
# To use Gmail:
# 1. Enable 2-Step Verification on your Google account
# 2. Go to: Google Account → Security → App Passwords
# 3. Generate an App Password for "Mail"
# 4. Paste the 16-character app password below
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password-here

# Company email that sends notifications
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Imani Logistics

# Admin email to receive internal alerts
ADMIN_EMAIL=admin@imanigifts.co.uk

# ============================================
# DATABASE
# ============================================
# SQLite DB file path (relative to backend/)
DB_PATH=./data/logistics.db

# ============================================
# CORS
# ============================================
# Frontend origin (update for production)
FRONTEND_URL=http://localhost:3000
